# Local hackathon demo. Copy to .env (never commit .env).
# The demo home is synthetic, so the app runs as one shared local user.
AUTH_DISABLED=true
APP_NAME=care-desk

# The agent ("Ask Anji") needs one model provider key in your shell or here,
# or a key saved in the app's Settings > Agent. For example:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
