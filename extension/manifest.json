{
  "manifest_version": 3,
  "name": "Anji for managers",
  "short_name": "Anji",
  "version": "0.2.0",
  "description": "Anji sits beside your care system: who this resident is, what needs attention, and care-plan suggestions you decide on.",
  "icons": {
    "16": "icons/angel-16.png",
    "48": "icons/angel-48.png",
    "128": "icons/angel-128.png"
  },
  "action": {
    "default_title": "Open Anji",
    "default_icon": {
      "16": "icons/angel-16.png",
      "48": "icons/angel-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5490/*",
    "http://127.0.0.1:5490/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5490/desk*",
        "http://127.0.0.1:5490/desk*"
      ],
      "js": [
        "src/shared/diff.js",
        "src/content/adapters.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
